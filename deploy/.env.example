POSTGRES_DB=monevo
POSTGRES_USER=monevo
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=451912785888-ko2l1q15auq8jj4u8ugbb7vmjnl12dtl.apps.googleusercontent.com
CLERK_SECRET_KEY=sk_test_...

# Public HTTPS hostname for the API. DNS must point at this EC2 instance and
# security-group inbound 80 + 443 must be open so Caddy can get a certificate.
# Example: api.example.com (or 3-24-68-57.sslip.io while testing).
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Optional: comma-separated list of allowed browser origins (Expo web, admin tools).
# Leave empty for mobile-only usage.
CORS_ORIGIN=
# Set to false to disable the public Swagger UI in production.
SWAGGER_ENABLED=false
# Optional: Sentry DSN for backend error reporting (leave empty to disable).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Optional: pino log level (fatal|error|warn|info|debug|trace). Defaults to info.
LOG_LEVEL=info

# Public legal pages. The app links to the GitHub Pages site (docs/ folder,
# https://vileyy.github.io/monevo) so it survives API redeploys and IP changes.
# The API still serves the same pages at /legal/* for direct access.
# Use a real inbox: Google Play reviewers use it.
LEGAL_APP_NAME=Monevo
LEGAL_OPERATOR_NAME=Doan Quoc Hieu
LEGAL_COUNTRY=Vietnam
LEGAL_CONTACT_EMAIL=doanquochieu2104@gmail.com
LEGAL_LAST_UPDATED=2026-10-25

# Demo account created by `pnpm --filter backend db:seed`.
# Generate a unique password (e.g. `openssl rand -base64 24`) and put the
# same email/password in Play Console > App access. Never commit the value.
DEMO_EMAIL=demo@monevo.app
DEMO_PASSWORD=
